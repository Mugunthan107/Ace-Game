# Supabase Configuration (Required for database & auth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Metered WebRTC Configuration (Optional - for in-game voice chat)
VITE_METERED_APP_NAME=your_app_name
VITE_METERED_API_KEY=your_api_key
VITE_METERED_USERNAME=your_username
VITE_METERED_CREDENTIAL=your_credential

